# Zarchbot Webhook Service – handles incoming Twilio voice calls (Gunicorn, 4 workers; prewarm runs in scheduler)
# Install: sudo cp zarchbot-webhook.service /etc/systemd/system/
#         sudo systemctl daemon-reload && sudo systemctl enable zarchbot-webhook && sudo systemctl start zarchbot-webhook

[Unit]
Description=Zarchbot Incoming Call Webhook
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/zarchbot
Environment="PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/root/zarchbot/.env

ExecStart=/usr/local/bin/gunicorn -w 4 -b 0.0.0.0:5000 --timeout 60 webhook:app

Restart=on-failure
RestartSec=5

# Leave headroom for other services on the box: cap at 4 cores, run with lower priority
CPUQuota=400%
Nice=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
